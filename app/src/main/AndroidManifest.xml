<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Auto-update (2026-08-05): app downloads its own APK + prompts install. Android 8+
         needs this explicit permission (one-time "allow this app to install apps" grant). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 2026-08-05: call-duration tracking. READ_PHONE_STATE to detect call-end via
         TelephonyManager, READ_CALL_LOG to read the actual duration afterward. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- 2026-08-06 (v1.6): Bulk SMS. The CRM queues numbers, this app pulls them one at a
         time and sends through the phone's own SIM, so the staff member's existing daily
         SMS allowance is what pays for it. Server side counts and caps; this only sends. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/live_backup_rules"
        android:dataExtractionRules="@xml/live_data_extraction"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LiveCallSetupActivity" android:exported="false" />
        <activity android:name=".InCallActivity" android:exported="false" android:launchMode="singleTop" android:showWhenLocked="true" android:turnScreenOn="true" />
        <activity android:name=".DialerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <service android:name=".LiveInCallService" android:permission="android.permission.BIND_INCALL_SERVICE" android:exported="true">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter><action android:name="android.telecom.InCallService" /></intent-filter>
        </service>

        <!-- 2026-09: second launcher icon (same APK, same MainActivity, same permissions).
             Students get their own home-screen icon that opens /student/login instead of the
             staff CRM root. No new Activity: MainActivity reads intent.component to see which
             alias it was launched through, and picks the URL from that. -->
        <activity-alias
            android:name=".StudentEntry"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name_student">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Downloaded APK file:// URIs need a content:// FileProvider on Android 7+ before
             they can be passed to the package installer intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.apsconnect.autodial.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
