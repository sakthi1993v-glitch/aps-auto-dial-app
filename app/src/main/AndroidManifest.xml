<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Auto-update (2026-08-05): app downloads its own APK + prompts install. Android 8+
         needs this explicit permission (one-time "allow this app to install apps" grant). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- READ_CALL_LOG (call-duration report feature) — Phase 2-la add pannuvom, andha
         code actual-a irukkumbodhu mattum request pannanum, ippo venaam. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Downloaded APK file:// URIs need a content:// FileProvider on Android 7+ before
             they can be passed to the package installer intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.apsconnect.autodial.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
